# Copia este archivo a .env y rellena tus valores. NUNCA subas tu .env real.
# IMPORTANTE: server.py NO carga .env por si solo. Pasa estas variables en el bloque "env"
# de tu cliente MCP (ver README). Solo scripts/verify/run_verify.py lee .env, y unicamente
# las variables BINANCE_TESTNET_API_* de abajo.

# --- Servidor MCP ---------------------------------------------------------------
# API key y secret (HMAC). Solo hacen falta para consultas privadas (saldos, ordenes).
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Red: true = testnet de spot (default), false = Binance real.
BINANCE_TESTNET=true

# Permiso para crear/cancelar ordenes. Independiente de la red: false (default) = solo lectura.
BINANCE_ALLOW_TRADING=false

# Ventana de validez de la firma en ms (1..60000, default 5000).
BINANCE_RECV_WINDOW=5000

# --- Verificacion de integracion (scripts/verify/run_verify.py) -----------------
# Claves EXCLUSIVAS de https://testnet.binance.vision. No pongas claves de produccion.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
