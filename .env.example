# Copia este archivo a .env y rellena tus valores. / Copy to .env and fill in.
# NUNCA subas tu .env real al repositorio. / NEVER commit your real .env.

# Tu API key de Binance / Your Binance API key
BINANCE_API_KEY=

# Tu secret key (HMAC) / Your secret key (HMAC)
BINANCE_API_SECRET=

# "true" usa el testnet de spot (recomendado para probar) / use spot testnet
BINANCE_TESTNET=true

# "true" habilita retiros. NO lo actives sin entender el riesgo.
# enables withdrawals. Do NOT enable without understanding the risk.
ENABLE_WITHDRAWALS=false

# Ventana de validez de la firma en ms / signature validity window in ms
BINANCE_RECV_WINDOW=5000
